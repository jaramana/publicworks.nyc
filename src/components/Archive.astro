---
import '../styles/global.css';
import '../styles/register.css';
import '../styles/appearance.css';
import BaseHead from './BaseHead.astro';
import Mark from './Mark.astro';
import Controls from './Controls.astro';
import { register } from '../i18n/register.js';
import { localizePath, defaultLang, siteName, githubUrl } from '../i18n/ui.js';
import { buildIndex } from '../entries.js';
const { lang = defaultLang } = Astro.props;
const t = register[lang];
const { groups, entries } = await buildIndex(lang, t);
---
<!doctype html>
<html lang={lang} class="register-document">
<head><BaseHead description={t.sub} /><script is:inline>document.documentElement.classList.add('has-js');</script></head>
<body class="register-site">
<a class="skip-link" href="#index">{t.skip}</a>
<div class="register-layout">
 <main id="index" class="register-index" tabindex="-1">
  <header class="mast"><div><h1><a class="home-link" href={localizePath('/',lang)}><Mark />{siteName}</a></h1><p class="sub">{t.sub}</p><p class="index-meta">{t.index} · {entries.length} {t.entries}</p></div><Controls lang={lang} /></header>
  {groups.map(group=><section class="register-group" aria-label={group}>
   <div class="register-head"><h2 class="group-name">{group}</h2><span>{t.year}</span></div>
   {entries.filter(e=>e.group===group).map(e=><a class="register-row" id={'entry-'+e.key} data-entry={e.key} data-repo={e.repository} href={'#record-'+e.key} aria-controls={'record-'+e.key}><span class="entry-title">{e.title}<small>{e.summary}</small></span><span class="year" title={e.year ? undefined : t.noDate}>{e.year ?? "—"}</span></a>)}
  </section>)}
  <footer class="register-footer"><p>{siteName} · {t.place} · <a href={githubUrl}>GitHub</a></p><p>{t.privacy}</p></footer>
 </main>
 <aside class="record-desk" aria-label={t.record}>
  <div class="empty-record"><h2>{t.select}</h2><p class="record-kind">{t.selectNote}</p></div>
  {entries.map(e=><section class="record-panel" id={'record-'+e.key} data-record={e.key} aria-labelledby={'title-'+e.key}>
   <a class="return-index" href={'#entry-'+e.key}>← {t.back}</a>
   {e.shot && <img class="record-shot" src={e.shot} alt="" loading="lazy" decoding="async" />}
   <h2 id={'title-'+e.key} tabindex="-1">{e.title}</h2><p class="record-kind">{e.kind}</p>
   <p class="record-body">{e.body}</p>
   <dl class="record-fields">
    {e.keywords?.length > 0 && <><dt>{t.keywords}</dt><dd>{e.keywords.join(', ')}</dd></>}
    {e.source && <><dt>{t.source}</dt><dd>{e.source}</dd></>}
    {e.scope && <><dt>{t.scope}</dt><dd>{e.scope}</dd></>}
    {e.built && <><dt>{t.built}</dt><dd>{e.built}</dd></>}
    {e.languages && <><dt>{t.languages}</dt><dd>{e.languages}</dd></>}
    {e.repository && <><dt>{t.code}</dt><dd><a href={e.repository}>{e.repository.replace('https://github.com/','')}</a></dd></>}
   </dl>
   {e.href && <a class="record-open" href={e.href}>{e.action} {e.arrow ?? '↗'}</a>}
  </section>)}
 </aside>
</div>
<p class="sr-only" role="status" data-announcement></p>
<script>
 const rows=[...document.querySelectorAll<HTMLAnchorElement>('[data-entry]')];
 const panels=[...document.querySelectorAll<HTMLElement>('[data-record]')];
 const empty=document.querySelector<HTMLElement>('.empty-record')!;
 const desk=document.querySelector<HTMLElement>('.record-desk')!;
 const mobile=matchMedia('(max-width:800px)');
 function fromUrl(){const url=new URL(location.href);return url.hash.startsWith('#record-') ? url.hash.slice(8) : url.searchParams.get('p');}
 function select(key:string|null, focus=false){
  const panel=panels.find(p=>p.dataset.record===key);
  const previousRow=rows.find(r=>r.hasAttribute('aria-current'));
  const focusWasInDetails=desk.contains(document.activeElement);
  panels.forEach(p=>p.hidden=p!==panel);
  empty.hidden=!!panel;
  desk.classList.toggle('has-record',!!panel);
  rows.forEach(r=>{if(r.dataset.entry===key&&panel)r.setAttribute('aria-current','true');else r.removeAttribute('aria-current');});
  document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(a=>{const u=new URL(a.href);if(panel&&key)u.searchParams.set('p',key);else u.searchParams.delete('p');a.href=u.href;});
  document.querySelector('[data-announcement]')!.textContent=panel?.querySelector('h2')?.textContent||'';
  if(!panel && focusWasInDetails)previousRow?.focus({preventScroll:true});
  if(panel){desk.scrollTop=0;if(focus){panel.querySelector('h2')!.focus({preventScroll:true});if(mobile.matches)desk.scrollIntoView({behavior:'instant',block:'start'});}}
 }
 // Clicks create a history entry; arrow browsing updates the current selection.
 function openEntry(row:HTMLAnchorElement, keyboard=false, replace=false){
  const url=new URL(location.href);
  url.searchParams.set('p',row.dataset.entry!);url.hash='';
  if(url.href!==location.href){
   if(replace)history.replaceState(null,'',url);
   else history.pushState(null,'',url);
  }
  select(row.dataset.entry!,keyboard && !replace);
  if(replace){row.focus({preventScroll:true});row.scrollIntoView({block:'nearest'});}
  else if(mobile.matches)desk.scrollIntoView({behavior:'instant',block:'start'});
 }
 rows.forEach(row=>row.addEventListener('click',event=>{
  // Shift-click a row and you get the repository instead of the record.
  if(event.shiftKey&&row.dataset.repo){event.preventDefault();window.open(row.dataset.repo,'_blank','noopener');return;}
  if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
  event.preventDefault();openEntry(row,event.detail===0);
 }));

 /* ---- keyboard --------------------------------------------------------
    Nothing on the page explains these. They are there for anyone who tries
    them and invisible to anyone who does not:

      - arrow keys, or j and k, walk the whole drawer
      - typing jumps to a project by name
      - shift-click, or shift-Enter, opens the repository
      - type 1999 and the site shows you what it is underneath

    All of it is decoration on top of a list of links. Turn off CSS and
    JavaScript and the records are still reachable.
 ---------------------------------------------------------------------- */
 let year='', yearTimer:ReturnType<typeof setTimeout>, showingRaw=false;
 const titles=rows.map(row=>row.querySelector('.entry-title')!.firstChild!.textContent!.toLowerCase());
 let buffer='', bufferTimer:ReturnType<typeof setTimeout>;

 document.addEventListener('keydown',event=>{
  if(showingRaw||event.metaKey||event.ctrlKey||event.altKey)return;
  const active=document.activeElement;
  const focused=rows.findIndex(row=>row===active);
  if(focused<0 && active!==document.body && active!==document.getElementById('index'))return;
  const current=focused>=0 ? focused : rows.findIndex(row=>row.hasAttribute('aria-current'));

  // Shift-Enter only opens a repository when a row actually has focus.
  if(event.key==='Enter'&&event.shiftKey){
   const repo=focused>=0 && rows[focused].dataset.repo;
   if(repo){event.preventDefault();location.href=repo;}
   return;
  }

  let next:number|undefined;
  if(event.key==='ArrowDown'||event.key==='j'||(mobile.matches&&event.key==='ArrowRight'))next=(current+1)%rows.length;
  else if(event.key==='ArrowUp'||event.key==='k'||(mobile.matches&&event.key==='ArrowLeft'))next=(current<0 ? rows.length-1 : current-1+rows.length)%rows.length;
  else if(event.key==='Home')next=0;
  else if(event.key==='End')next=rows.length-1;
  if(next!==undefined){event.preventDefault();openEntry(rows[next],true,true);return;}

  // Type-ahead: printable keys build a prefix and jump to it. Digits are
  // left alone so they can reach the year listener below.
  if(event.key.length===1&&!(event.key>='0'&&event.key<='9')){
   buffer+=event.key.toLowerCase();
   clearTimeout(bufferTimer);
   bufferTimer=setTimeout(()=>buffer='',800);
   let hit=titles.findIndex(title=>title.startsWith(buffer));
   if(hit<0)hit=titles.findIndex(title=>title.includes(buffer));
   if(hit>=0){event.preventDefault();openEntry(rows[hit],true,true);}
  }
 });

 function clearSelection(){
  const url=new URL(location.href);
  url.searchParams.delete('p');url.hash='';
  if(url.href!==location.href)history.pushState(null,'',url);
  select(null);
 }
 document.querySelectorAll<HTMLAnchorElement>('.return-index').forEach(a=>a.addEventListener('click',event=>{
  if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
  event.preventDefault();
  const row=document.getElementById(a.hash.slice(1));
  clearSelection();
  row?.focus({preventScroll:true});
  if(mobile.matches)row?.scrollIntoView({behavior:'instant',block:'center'});
 }));
 // The title returns the page to its rest state, with no record and scrolled to the top.
 document.querySelector<HTMLAnchorElement>('.home-link')?.addEventListener('click',event=>{
  if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
  event.preventDefault();
  clearSelection();
  scrollTo({top:0,behavior:'instant'});
  document.getElementById('index')!.focus({preventScroll:true});
 });
 addEventListener('popstate',()=>select(fromUrl(),desk.contains(document.activeElement)));
 addEventListener('hashchange',()=>select(fromUrl()));

 /* ---- 1999: the site shows what it is underneath ---------------------- */

 function nineteenNinetyNine(){
  if(showingRaw)return;
  showingRaw=true;
  const list=rows.map(row=>{
   const panel=panels.find(p=>p.dataset.record===row.dataset.entry)!;
   return {
    title:panel.querySelector('h2')!.textContent!,
    filed:panel.querySelector('.record-kind')!.textContent!.replace(' · ',', '),
    href:panel.querySelector<HTMLAnchorElement>('.record-open')?.getAttribute('href')
   };
  });
  document.querySelectorAll<HTMLStyleElement|HTMLLinkElement>('style,link[rel=stylesheet]').forEach(s=>s.disabled=true);
  const heading=document.createElement('h1');
  heading.textContent=document.title;
  const ul=document.createElement('ul');
  list.forEach(item=>{
   const li=document.createElement('li');
   if(item.href){const a=document.createElement('a');a.href=item.href;a.textContent=item.title;li.append(a);}
   else li.append(item.title);
   li.append(' ('+item.filed+')');
   ul.append(li);
  });
  document.body.replaceChildren(heading,ul);
  setTimeout(restore,5000);
  document.addEventListener('keydown',restore,{once:true});
  document.addEventListener('click',restore,{once:true});
 }
 /* Reloading is the honest way back: replacing the body dropped every
    listener with it, and the ?p= query brings the same record back. */
 function restore(){
  if(!showingRaw)return;
  showingRaw=false;
  location.reload();
 }

 /* No focus gate here. On a fresh page load nothing has focus yet, and an
    easter egg you have to click into first is not an easter egg. */
 document.addEventListener('keydown',event=>{
  if(showingRaw||event.metaKey||event.ctrlKey||event.altKey)return;
  if(event.key>='0'&&event.key<='9'){
   year=(year+event.key).slice(-4);
   clearTimeout(yearTimer);
   yearTimer=setTimeout(()=>year='',1200);
   if(year==='1999'){year='';nineteenNinetyNine();}
  }else if(event.key.length===1)year='';
 });

 /* The record is already on screen at load, so focusing it only adds a focus
    ring, which a keyboard reload makes visible. The status line announces the
    record instead. Mobile still gets the scroll, because the desk sits below
    the whole index. */
 const initial=fromUrl();
 select(initial);
 if(desk.classList.contains('has-record') && mobile.matches && window.self === window.top)desk.scrollIntoView({behavior:'instant',block:'start'});
</script>
</body>
</html>
