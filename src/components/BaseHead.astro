---
import { siteName, defaultLang, languages, locales } from '@site/site.js';
import { copy } from '@site/copy.js';
import { localizePath } from '../i18n.js';
import regular from '../fonts/pw-heros-regular.woff2?url';
import bold from '../fonts/pw-heros-bold.woff2?url';
const { lang = defaultLang, bare = null, title = siteName, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// The same page in the site's other languages, when it has them.
const alternates = bare && languages.length > 1 ? languages.map(code => ({ code, href: new URL(localizePath(bare, code), Astro.site) })) : [];

// The site's public/og.png, drawn by `npm run og`.
const shareImage = new URL('/og.png', Astro.site);
const shareAlt = `${siteName}. ${copy[defaultLang].intro}`;
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="preload" href={bold} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={regular} as="font" type="font/woff2" crossorigin />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
{!noindex && <link rel="canonical" href={canonical} />}
{!noindex && alternates.map(a => <link rel="alternate" hreflang={a.code} href={a.href} />)}
{!noindex && alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(localizePath(bare, defaultLang), Astro.site)} />}
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0c0c0d" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />
<title>{title}</title>
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={locales[lang].replace('-', '_')} />
<meta property="og:image" content={shareImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={shareAlt} />
<meta name="twitter:card" content="summary_large_image" />
