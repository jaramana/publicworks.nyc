---
/* Links to this page in each of the site's languages, by name. A language
   without this page links to its home page. */
import { defaultLang, languages, languageNames } from '@site/site.js';
import { localizePath } from '../i18n.js';
const { lang = defaultLang, bare = '/', available = languages } = Astro.props;
---
{languages.map(code => (
  <a
    href={localizePath(available.includes(code) ? bare : '/', code)}
    lang={code}
    hreflang={code}
    data-language
    aria-current={code === lang ? 'page' : undefined}
  >{languageNames[code]}</a>
))}
