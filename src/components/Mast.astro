---
/* The masthead. On the home page its links jump within the page; on any
   other page they lead back to it. A site in more than one language has a
   language menu after the nav. The home page slots find in after that. */
import Langs from './Langs.astro';
import { copy } from '@site/copy.js';
import { defaultLang, languages, languageNames, siteName } from '@site/site.js';
import { localizePath } from '../i18n.js';
import { getJournal } from '../entries.js';
const { lang = defaultLang, home = false, bare = '/', available = languages } = Astro.props;
const t = copy[lang];
const root = home ? '' : localizePath('/', lang);
const hasJournal = (await getJournal(lang)).length > 0;
const multi = languages.length > 1;
---
<div class="mast-sentinel" aria-hidden="true"></div>
<header class="mast" data-mast>
  <a class="wordmark" href={localizePath('/', lang)} data-home>{siteName}</a>
  <nav class="nav" aria-label={t.sections}>
    <a href={root + '#works'}>{t.works}</a>
    {hasJournal && <a href={root + '#journal'}>{t.journal}</a>}
    <a href={root + '#archive'}>{t.archive}</a>
    <a href={root + '#record-about'} data-open={home ? 'about' : undefined}>{t.about}</a>
  </nav>
  {multi && (
    <details class="langs-menu">
      <summary>{languageNames[lang]}<span class="sr-only"> ({t.language})</span></summary>
      <div class="langs-list"><Langs lang={lang} bare={bare} available={available} /></div>
    </details>
  )}
  <slot />
</header>
