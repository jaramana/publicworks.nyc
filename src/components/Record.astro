---
/* One record as the panel shows it. Without JavaScript every record sits in the page in this form. */
import Cover from './Cover.astro';
import { fill } from '../i18n/works.js';
const { r, t, prev, next, position } = Astro.props;
const { Content } = await r.entry.render();
---
<article class="record" id={'record-' + r.key} data-record={r.key} data-group={r.status} data-title={r.title} data-accent={r.accent} aria-labelledby={'title-' + r.key}>
  <header class="record-head">
    {r.cover && (
      <figure class="record-cover">
        <Cover src={r.cover} alt={fill(t.shotAlt, { title: r.title })} sizes="(min-width: 60rem) min(62vw, 1040px), 100vw" />
      </figure>
    )}
    <div class="record-titles">
      <p class="meta">{r.meta}{position && <span class="record-position"> · {position}</span>}</p>
      <h2 class="record-title" id={'title-' + r.key} tabindex="-1">{r.title}</h2>
    </div>
  </header>

  <p class="record-lead">{r.lead ?? r.summary}</p>

  <div class="record-grid">
    {r.specs.length > 0 && (
      <dl class="specs">
        {r.specs.map(s => <div class="spec"><dt>{s.label}</dt><dd>{s.href ? <a href={s.href}>{s.value}</a> : s.value}</dd></div>)}
      </dl>
    )}
    <div class="record-text">
      {r.hasBody ? <Content /> : <p>{r.description}</p>}
      {r.gallery?.map(g => (
        <figure class="record-figure">
          <Cover src={g.src} alt={g.alt} sizes="(min-width: 60rem) 40vw, 100vw" />
          <figcaption>{g.caption}</figcaption>
        </figure>
      ))}
      {r.limit && (
        <aside class="limit" aria-labelledby={'limit-' + r.key}>
          <p class="label" id={'limit-' + r.key}>{t.limit}</p>
          <p>{r.limit}</p>
        </aside>
      )}
    </div>
  </div>

  {r.links.length > 0 && (
    <ul class="record-links">
      {r.links.map(l => <li><a href={l.href}>{l.label} <span aria-hidden="true">→</span></a></li>)}
    </ul>
  )}

  {(prev || next) && (
    <nav class="record-steps" aria-label={t.record}>
      {prev ? <a class="step step--prev" href={'#record-' + prev.key} data-step={prev.key}><span class="label">← {t.previous}</span>{prev.title}</a> : <span />}
      {next && <a class="step step--next" href={'#record-' + next.key} data-step={next.key}><span class="label">{t.next} →</span>{next.title}</a>}
    </nav>
  )}
  <a class="record-back" href="#works">↑ {t.backToWorks}</a>
</article>
