---
/* One row in the Journal or the Archive. It opens the record's note. */
const { r } = Astro.props;
---
<li class="row" data-item={r.key} data-find={r.find}>
  <a class="row-link" href={'#record-' + r.key} data-open={r.key} data-repo={r.repository}>
    <span class="row-title">{r.title}</span>
    <span class="row-summary">{r.summary}</span>
    <span class="row-year">{r.year}</span>
    {r.address && <span class="row-addr">{r.address}</span>}
  </a>
</li>
