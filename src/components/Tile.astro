---
/* One work in the grid. The title link stretches over the whole tile. */
import Cover from './Cover.astro';
const { r, eager = false } = Astro.props;
const sizes = '(min-width: 35rem) 304px, calc(100vw - 40px)';
---
<li class="tile" data-item={r.key} data-find={r.find}>
  <div class="tile-media"><Cover src={r.cover} sizes={sizes} eager={eager} /></div>
  <p class="tile-meta">{r.meta}</p>
  <h3 class="tile-title"><a class="tile-link" href={'#record-' + r.key} data-open={r.key} data-repo={r.repository}>{r.title}</a></h3>
  <p class="tile-summary">{r.summary}</p>
</li>
