---
/* One work in the grid. The title link stretches over the whole tile. */
import Cover from './Cover.astro';
const { r, eager = false, priority = false } = Astro.props;
// The tile's rendered width at each step of the fluid grid in works.css.
// Change both together.
const sizes = [
  '(min-width: 73.9rem) 13.5rem',
  '(min-width: 67.4rem) calc(30.67vw - 9.17rem)',
  '(min-width: 52.5rem) calc(46vw - 12.63rem)',
  '(min-width: 42.4rem) calc(30.67vw - 1.5rem)',
  '(min-width: 31.25rem) calc(46vw - 1.13rem)',
  '(min-width: 27.75rem) calc(50vw - 2.38rem)',
  'calc(100vw - 2.5rem)',
].join(', ');
---
<li class="tile" data-item={r.key} data-find={r.find}>
  <div class="tile-media"><Cover src={r.cover} sizes={sizes} eager={eager} priority={priority} /></div>
  <p class="tile-meta">{r.meta}</p>
  <h3 class="tile-title"><a class="tile-link" href={'#record-' + r.key} data-open={r.key} data-repo={r.repository}>{r.title}</a></h3>
  {r.address && <p class="tile-addr">{r.address}</p>}
  <p class="tile-summary">{r.summary}</p>
</li>
