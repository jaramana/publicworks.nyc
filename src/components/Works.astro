---
import '../styles/fonts.css';
import '../styles/works.css';
import BaseHead from './BaseHead.astro';
import Tile from './Tile.astro';
import Note from './Note.astro';
import { works as copy, fill } from '../i18n/works.js';
import { localizePath, defaultLang, languages, languageNames, siteName, githubUrl, repoUrl, byline, sister } from '../i18n/ui.js';
import { buildIndex } from '../entries.js';
import { getEntry } from 'astro:content';

const { lang = defaultLang } = Astro.props;
const t = copy[lang];
const { works, archive, groups } = await buildIndex(lang, t);
const about = await getEntry('pages', 'about');
const { Content: AboutText } = await about.render();
const bare = Astro.url.pathname.replace(new RegExp('^/(' + languages.filter(c => c !== defaultLang).join('|') + ')(?=/|$)'), '') || '/';
---
<!doctype html>
<html lang={lang}>
<head>
  <BaseHead description={t.intro} />
  <script is:inline>document.documentElement.classList.add('has-js');</script>
</head>
<body>
<a class="skip" href="#works">{t.skip}</a>

<div class="mast-sentinel" aria-hidden="true"></div>
<header class="mast" data-mast>
  <a class="wordmark" href={localizePath('/', lang)} data-home>{siteName}</a>
  <nav class="nav" aria-label={t.sections}>
    <a href="#works">{t.works}</a>
    <a href="#archive">{t.archive}</a>
    <a href="#record-about" data-open="about">{t.about}</a>
    <a href={githubUrl}>{t.github}</a>
    {languages.length > 1 && languages.map(code => <a href={localizePath(bare, code)} lang={code} aria-label={languageNames[code]} aria-current={code === lang ? 'page' : undefined}>{code}</a>)}
  </nav>
  <div class="find" data-finder hidden>
    <label class="label" for="find-input">{t.find}</label>
    <input id="find-input" type="search" autocomplete="off" spellcheck="false" placeholder={t.findPlaceholder} data-find-input />
    <output class="find-count" for="find-input" data-find-count data-of={t.findCount} data-none={t.findNone}></output>
  </div>
</header>

<div class="page">
  <main class="main" id="main">
    <h1 class="sr-only">{siteName}</h1>

    <section class="band" id="works" aria-labelledby="works-label" tabindex="-1">
      <div class="band-head"><h2 class="label" id="works-label">{t.works}</h2></div>
      <div class="band-body">
        <ul class="tiles" role="list">
          {works.map((r, i) => <Tile r={r} eager={i < 4} />)}
        </ul>
      </div>
    </section>

    <section class="band" id="archive" aria-labelledby="archive-label" tabindex="-1">
      <div class="band-head">
        <h2 class="label" id="archive-label">{t.archive}</h2>
        <span class="find-hits label" data-archive-hits data-found={t.findArchive}></span>
      </div>
      <div class="band-body">
        <p class="band-note">{t.archiveNote}</p>
        {groups.map(g => (
          <div class="group">
            <h3 class="group-name label">{g.name}</h3>
            <ul class="rows" role="list">
              {g.entries.map(r => (
                <li class="row" data-item={r.key} data-find={r.find}>
                  <a class="row-link" href={'#record-' + r.key} data-open={r.key} data-repo={r.repository}>
                    <span class="row-title">{r.title}</span>
                    <span class="row-summary">{r.summary}</span>
                    <span class="row-year">{r.year}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>

  <aside class="side" aria-label={t.record} data-panel>
    <h2 class="label records-label">{t.records}</h2>
    <div class="side-inner" data-panel-inner>
      <article class="note is-shown" id="record-about" data-note="about" data-title={about.data.title} aria-labelledby="title-about">
        <div class="note-main">
          <p class="note-meta">{siteName}</p>
          <h2 class="note-title" id="title-about" tabindex="-1">{about.data.title}</h2>
          <p class="note-lead">{about.data.lead}</p>
        </div>
        <div class="note-side">
          <details class="more">
            <summary>{t.more}</summary>
            <div class="more-body">
              <AboutText />
              <p class="byline" set:html={fill(t.byline, byline)} />
            </div>
          </details>
        </div>
      </article>
      {[...works, ...archive].map(r => <Note r={r} t={t} />)}
    </div>
  </aside>
</div>

<footer class="foot">
  <p class="notice" set:html={t.notice} />
  <div class="colophon">
    <p set:html={fill(t.byline, byline)} />
    <p set:html={fill(t.sister, sister)} />
    <p><a href={repoUrl}>{t.sourceCode}</a> · {t.privacy}</p>
  </div>
</footer>

<p class="sr-only" role="status" data-announce></p>

<script>
  import '../scripts/works.ts';
</script>
</body>
</html>
