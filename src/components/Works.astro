---
import '../styles/fonts.css';
import '../styles/works.css';
import BaseHead from './BaseHead.astro';
import Mast from './Mast.astro';
import Foot from './Foot.astro';
import Tile from './Tile.astro';
import Note from './Note.astro';
import Row from './Row.astro';
import { copy } from '@site/copy.js';
import { defaultLang, languages, siteName } from '@site/site.js';
import { buildIndex } from '../entries.js';
import { getCollection, render } from 'astro:content';

const { lang = defaultLang } = Astro.props;
const t = copy[lang];
const { works, archive, groups, journal } = await buildIndex(lang, t);
const [about] = await getCollection('pages', p => p.data.lang === lang);
if (!about) throw new Error(`There is no About page in "${lang}".`);
const { Content: AboutText } = await render(about);
const bare = Astro.url.pathname.replace(new RegExp('^/(' + languages.filter(c => c !== defaultLang).join('|') + ')(?=/|$)'), '') || '/';
---
<!doctype html>
<html lang={lang}>
<head>
  <BaseHead lang={lang} bare={bare} description={t.intro} />
  <script is:inline>document.documentElement.classList.add('has-js');</script>
</head>
<body>
<a class="skip" href="#works">{t.skip}</a>

<Mast lang={lang} home bare={bare}>
  <div class="find" data-finder hidden>
    <label class="label" for="find-input">{t.find}</label>
    <input id="find-input" type="search" autocomplete="off" spellcheck="false" placeholder={t.findPlaceholder} data-find-input />
    <output class="find-count" for="find-input" data-find-count data-of={t.findCount} data-none={t.findNone}></output>
  </div>
</Mast>

<div class="page">
  <main class="main" id="main">
    <h1 class="sr-only">{siteName}</h1>

    <section class="band" id="works" aria-labelledby="works-label" tabindex="-1">
      <div class="band-head"><h2 class="label" id="works-label">{t.works}</h2></div>
      <div class="band-body">
        <ul class="tiles" role="list">
          {works.map((r, i) => <Tile r={r} eager={i < 2} priority={i === 0} />)}
        </ul>
      </div>
    </section>

    {journal.length > 0 && (
      <section class="band" id="journal" aria-labelledby="journal-label" tabindex="-1">
        <div class="band-head">
          <h2 class="label" id="journal-label">{t.journal}</h2>
          <span class="find-hits label" data-band-hits data-found={t.findJournal}></span>
        </div>
        <div class="band-body">
          {t.journalNote && <p class="band-note">{t.journalNote}</p>}
          <ul class="rows" role="list">
            {journal.map(r => <Row r={r} />)}
          </ul>
        </div>
      </section>
    )}

    <section class="band" id="archive" aria-labelledby="archive-label" tabindex="-1">
      <div class="band-head">
        <h2 class="label" id="archive-label">{t.archive}</h2>
        <span class="find-hits label" data-band-hits data-found={t.findArchive}></span>
      </div>
      <div class="band-body">
        <p class="band-note">{t.archiveNote}</p>
        {groups.map(g => (
          <div class="group">
            <h3 class="group-name label">{g.name}</h3>
            <ul class="rows" role="list">
              {g.entries.map(r => <Row r={r} />)}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>

  <aside class="side" aria-label={t.record} data-panel>
    <h2 class="label records-label">{t.records}</h2>
    <div class="side-inner" data-panel-inner>
      <article class="note is-shown" id="record-about" data-note="about" data-title={about.data.title} aria-labelledby="title-about">
        <section class="pg pg-overview is-page" data-label={t.overview} tabindex="-1">
          <div class="note-main">
            <p class="note-meta">{siteName}</p>
            <h2 class="note-title" id="title-about" tabindex="-1">{about.data.title}</h2>
            <p class="note-lead">{about.data.lead}</p>
          </div>
        </section>
        {about.body?.trim() && (
          <section class="pg pg-prose" data-label={t.more} data-split tabindex="-1">
            <p class="pg-head">{about.data.title}</p>
            <AboutText />
          </section>
        )}
      </article>
      {[...works, ...journal, ...archive].map(r => <Note r={r} t={t} />)}
    </div>
    <nav class="pager" aria-label={t.pages} data-pager>
      <button type="button" data-turn="-1" aria-label={t.previousPage}><span aria-hidden="true">←</span></button>
      <span class="pager-label" aria-live="polite" data-pager-label data-of={t.pageOf} data-continued={t.continued}></span>
      <button type="button" data-turn="1" aria-label={t.nextPage}><span aria-hidden="true">→</span></button>
    </nav>
  </aside>
</div>

<Foot lang={lang} />

<p class="sr-only" role="status" data-announce></p>

<script>
  import '../scripts/works.ts';
</script>
</body>
</html>
