---
import '../styles/global.css';
import '../styles/register.css';
import '../styles/appearance.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { archive } from '../i18n/archive.js';
import { defaultLang, siteName } from '../i18n/ui.js';
const { lang = defaultLang, title = siteName, description = archive[lang].intro, noindex = false } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head><BaseHead title={title} description={description} noindex={noindex} /></head>
<body>
  <a class="skip-link" href="#main">{archive[lang].skip}</a>
  <Header lang={lang} />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer lang={lang} />
</body>
</html>
