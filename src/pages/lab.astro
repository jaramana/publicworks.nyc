---
/* Lab: five studies for where a project's details appear. Not linked from
   the site. Delete this page, LabNote, lab.css and lab.ts before merging. */
import '../styles/fonts.css';
import '../styles/lab.css';
import BaseHead from '../components/BaseHead.astro';
import Cover from '../components/Cover.astro';
import LabNote from '../components/LabNote.astro';
import { works as copy, fill } from '../i18n/works.js';
import { defaultLang, siteName, githubUrl, repoUrl, byline, sister } from '../i18n/ui.js';
import { buildIndex } from '../entries.js';
import { getEntry } from 'astro:content';

const t = copy[defaultLang];
const { works, archive, groups } = await buildIndex(defaultLang, t);
const about = await getEntry('pages', 'about');
const { Content: AboutText } = await about.render();

const studies = [
  { n: 1, name: 'Card', note: 'A centered card over a veiled page. Familiar and contained.' },
  { n: 2, name: 'Side', note: 'The previous iteration, redone. The index stays left and the record keeps a column on the right. At rest the column shows About.' },
  { n: 3, name: 'Inline', note: 'The details open inside the grid, under the project’s row. Nothing covers the page.' },
  { n: 4, name: 'Caption', note: 'A museum caption along the bottom edge. The page stays where it is.' },
  { n: 5, name: 'Margin', note: 'Titles only. Details appear in the white margin, level with their title. Hover to preview, click to pin.' },
  { n: 6, name: 'Drawer', note: 'A narrow glass column slides over the right edge, under the masthead. Nothing reflows. Click away, press Esc or click the tile again to close.' },
];

// Side won. Its variants keep the column from scrolling on its own.
const variants = [
  { id: 'fit', name: 'Fit', key: 'F', note: 'The note keeps only what always fits: title, lead, links, tools and date. The write-up stays on each product’s About page. Short windows drop the thumbnail, then the specs. The column never scrolls.' },
  { id: 'anchored', name: 'Anchored', key: 'A', note: 'The note sits level with the tile you clicked and scrolls with the page, under the glass like everything else. Every note has the same shape: lead, links, Data, Built with, Updated, then your take. One scroll.' },
  { id: 'pages', name: 'Pages', key: 'P', note: 'The column holds still and never scrolls. Longer notes split into short pages: Overview, Details, then each section. The pager or ← → turns them.' },
];
const earlier = studies.filter(s => s.n !== 2);
---
<!doctype html>
<html lang={defaultLang} data-study="2" data-variant="anchored" data-cols="auto">
<head>
  <BaseHead title={'Lab · ' + siteName} description="Layout studies." noindex />
  <script is:inline>
    (() => {
      const q = new URLSearchParams(location.search);
      const d = document.documentElement;
      if (/^[1-6]$/.test(q.get('s') ?? '')) d.dataset.study = q.get('s');
      if (['fit', 'anchored', 'pages'].includes(q.get('v'))) d.dataset.variant = q.get('v');
      if (['auto', '2', '3'].includes(q.get('cols'))) d.dataset.cols = q.get('cols');
      if (q.get('theme') === 'dark') d.dataset.theme = 'dark';
      d.classList.add('has-js');
    })();
  </script>
</head>
<body>

<nav class="lab-bar" aria-label="Lab">
  <span class="lab-tag">Lab</span>
  <span class="lab-group"><span class="lab-group-name">Side</span>{variants.map(v => <a href={`?s=2&v=${v.id}`} data-variant-link={v.id}>{v.name} <kbd>{v.key}</kbd></a>)}</span>
  <span class="lab-group"><span class="lab-group-name">Earlier</span>{earlier.map(s => <a href={`?s=${s.n}`} data-study-link={s.n}>{s.name} <kbd>{s.n}</kbd></a>)}</span>
  <span class="lab-group"><span class="lab-group-name">Columns</span>{['auto', '2', '3'].map(c => <a href={`?cols=${c}`} data-cols-link={c}>{c === 'auto' ? 'Auto' : c}</a>)}</span>
  <a class="lab-theme" href="?theme=dark" data-theme-link>Dark</a>
  {variants.map(v => <p class="lab-note" data-for={'side-' + v.id}>{v.note}</p>)}
  {earlier.map(s => <p class="lab-note" data-for={String(s.n)}>{s.note}</p>)}
</nav>

<div class="mast-sentinel" aria-hidden="true"></div>
<header class="mast">
  <a class="wordmark" href="/lab/">{siteName}</a>
  <nav class="nav" aria-label={t.sections}>
    <a href="#works">{t.works}</a>
    <a href="#archive">{t.archive}</a>
    <a href="#note-about" data-open="about">{t.about}</a>
    <a href={githubUrl}>{t.github}</a>
  </nav>
</header>

<div class="page">
  <main class="main" id="main">
    <h1 class="sr-only">{siteName}</h1>

    <section class="band" id="works" aria-labelledby="works-label">
      <h2 class="band-label" id="works-label">{t.works}</h2>
      <div class="band-body">
        <ul class="tiles" role="list">
          {works.map((r, i) => (
            <li class="tile" data-item={r.key}>
              <a class="tile-link" href={'#note-' + r.key} data-open={r.key}>
                <span class="tile-media"><Cover src={r.cover} sizes="(min-width: 90rem) 320px, (min-width: 56rem) 26vw, (min-width: 32rem) 45vw, 100vw" eager={i < 6} /></span>
                <span class="tile-meta">{r.meta}</span>
                <span class="tile-title">{r.title}</span>
                <span class="tile-summary">{r.summary}</span>
              </a>
            </li>
          ))}
        </ul>
        <ul class="list" role="list">
          {works.map(r => (
            <li class="item" data-item={r.key}>
              <a class="item-link" href={'#note-' + r.key} data-open={r.key}>
                <span class="item-title">{r.title}</span>
                <span class="item-summary">{r.summary}</span>
                <span class="item-meta">{r.meta}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band" id="archive" aria-labelledby="archive-label">
      <h2 class="band-label" id="archive-label">{t.archive}</h2>
      <div class="band-body">
        <p class="band-note">{t.archiveNote}</p>
        {groups.map(g => (
          <div class="group">
            <h3 class="group-name">{g.name}</h3>
            <ul class="rows" role="list">
              {g.entries.map(r => (
                <li class="row" data-item={r.key}>
                  <a class="row-link" href={'#note-' + r.key} data-open={r.key}>
                    <span class="row-title">{r.title}</span>
                    <span class="row-summary">{r.summary}</span>
                    <span class="row-year">{r.year}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>

  <aside class="side" data-side aria-label="Project">
    <div class="side-inner" data-side-inner>
      <div class="slot" data-slot></div>
    </div>
  </aside>

  <aside class="margin" data-margin aria-label="Project">
    <div class="slot" data-slot></div>
  </aside>
</div>

<footer class="foot">
  <p class="notice" set:html={t.notice} />
  <div class="colophon">
    <p set:html={fill(t.byline, byline)} />
    <p set:html={fill(t.sister, sister)} />
    <p><a href={repoUrl}>{t.sourceCode}</a> · {t.privacy}</p>
  </div>
</footer>

<aside class="drawer" data-drawer aria-label="Project">
  <button type="button" class="close" data-close>Close</button>
  <div class="slot" data-slot></div>
</aside>

<dialog class="card" data-card aria-label="Project">
  <div class="card-bar"><button type="button" class="close" data-close>Close</button></div>
  <div class="slot" data-slot></div>
</dialog>

<section class="caption" data-caption aria-label="Project" hidden>
  <button type="button" class="close" data-close>Close</button>
  <div class="slot" data-slot></div>
</section>

<div class="notes" hidden>
  {[...works, ...archive].map(r => <LabNote r={r} t={t} />)}
  <article class="note" id="note-about" data-note="about">
    <div class="note-main">
      <p class="note-meta">{siteName}</p>
      <h2 class="note-title" tabindex="-1">{about.data.title}</h2>
      <p class="note-lead">{about.data.lead}</p>
    </div>
    <div class="note-side">
      <details class="more">
        <summary>More</summary>
        <div class="more-body">
          <AboutText />
          <p class="byline" set:html={fill(t.byline, byline)} />
        </div>
      </details>
    </div>
  </article>
</div>

<script>
  import '../scripts/lab.ts';
</script>
</body>
</html>
